# ── LLM 後端 ──────────────────────────────────────────────────
LOCAL_LLM_URL=http://localhost:1234
LOCAL_LLM_MODEL=qwen3.5-27b-claude-4.6-opus-distilled-mlx

# ── Telegram 推播（選填）──────────────────────────────────────
# 未設定時 pipeline 照常執行，僅靜默略過推播與告警。
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Obsidian vault 存檔（選填）────────────────────────────────
# 未設定 VAULT_ROOT 時 save 步驟自動略過，其餘 pipeline 不受影響。
# 設定為你的 Obsidian vault 根目錄即啟用（report.md / digest 會同步進去）。
# VAULT_ROOT=/Users/yourname/Library/Mobile Documents/iCloud~md~obsidian/Documents/YourVault

# ── Judge LLM（選填，預設與主 LLM 相同）─────────────────────
# JUDGE_LLM_MODEL=google/gemma-4-e4b
# JUDGE_LLM_URL=http://localhost:1234

# ── Deploy（gh-pages 發佈，選填）──────────────────────────────
# cron 環境存取不到 osxkeychain，deploy step 的 git push 需要獨立認證。
# 到 GitHub → Settings → Developer settings → Fine-grained tokens 建立一個
# 只有本 repo「Contents: Read and write」權限的 token。未設定時，deploy 只能
# 靠互動式 session 的既有 git credential helper（cron 觸發會失敗）。
# DEPLOY_GITHUB_TOKEN=github_pat_xxx

# ── Stock Predictor（選填，僅 stock 功能需要）────────────────
# FINMIND_API_TOKEN=your_finmind_token_here
# STOCK_TELEGRAM_BOT_TOKEN=your_stock_bot_token_here
